{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductsListSchema",
  "type": "object",
  "required": ["success", "total", "products"],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "category", "description", "stock", "rating"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "badge": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
