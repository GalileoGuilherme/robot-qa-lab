{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrderResponseSchema",
  "type": "object",
  "required": ["success", "message", "order"],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "order": {
      "type": "object",
      "required": ["id", "createdAt", "status", "customerName", "customerEmail", "address", "shippingMethod", "shippingPrice", "discount", "total", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ORD-[0-9]+$"
        },
        "createdAt": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["CONFIRMED", "PENDING", "PROCESSING"]
        },
        "customerName": {
          "type": "string"
        },
        "customerEmail": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "shippingMethod": {
          "type": "string"
        },
        "shippingPrice": {
          "type": "number",
          "minimum": 0
        },
        "discount": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "price", "quantity"],
            "properties": {
              "id": { "type": "string" },
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "integer", "minimum": 1 },
              "subtotal": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
