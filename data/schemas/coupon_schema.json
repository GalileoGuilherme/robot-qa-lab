{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CouponValidationSchema",
  "type": "object",
  "required": ["valid", "code", "discountPercent", "message"],
  "properties": {
    "valid": { "type": "boolean" },
    "code": { "type": "string" },
    "discountPercent": { "type": "number", "minimum": 1, "maximum": 100 },
    "description": { "type": "string" },
    "message": { "type": "string" }
  },
  "additionalProperties": true
}
