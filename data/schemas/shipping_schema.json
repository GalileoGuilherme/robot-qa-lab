{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShippingCalculationSchema",
  "type": "object",
  "required": ["success", "cep", "methods"],
  "properties": {
    "success": { "type": "boolean" },
    "cep": { "type": "string" },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "deadlineDays"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "price": { "type": "number", "minimum": 0 },
          "deadlineDays": { "type": "integer", "minimum": 0 },
          "deadline": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": true
}
