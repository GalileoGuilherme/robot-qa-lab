{
  "name": "robot-qa-lab",
  "version": "1.0.0",
  "description": "Enterprise Full-Stack QA Automation Suite powered by Robot Framework (Web, API, Mobile, Performance SLA)",
  "scripts": {
    "test": "node scripts/run.js --layer all",
    "test:api": "node scripts/run.js --layer api",
    "test:web": "node scripts/run.js --layer web",
    "test:mobile": "node scripts/run.js --layer mobile",
    "test:perf": "node scripts/run.js --layer performance",
    "test:smoke": "node scripts/run.js --layer smoke",
    "test:headed": "node scripts/run.js --layer web --headed",
    "report:metrics": "node scripts/run.js --metrics-only",
    "check-env": "node scripts/run.js --check-env-only",
    "setup": "python -m pip install -r requirements.txt && rfbrowser init"
  },
  "keywords": [
    "robot-framework",
    "qa-automation",
    "playwright",
    "appium",
    "api-testing",
    "performance-telemetry",
    "sdet"
  ],
  "author": "Galileo Guilherme",
  "license": "MIT"
}
